# 복사해서 쓴다: cp .env.example .env  (.env는 절대 커밋하지 않는다)

# Eureka Process — mock: 메모리 가짜 Eureka(키 불필요) / real: 실제 API
EUREKA_MODE=mock
EUREKA_BASE_URL=https://api.eureka.codes/flw-v1
EUREKA_API_KEY=
EUREKA_PROCESS_ID=general-work-v1@10204

# LLM — ai 담당이 모델 확정 후 채운다 (src/desk_pet_backend/services/README.md)
LLM_MODEL=
LLM_API_KEY=

# Raspberry Pi 인증 — Hardware 레포 app/.env의 DEVICE_TOKEN과 같은 값으로 바꾼다
DEVICE_TOKEN=change-me

# 선제 알림
POLL_INTERVAL_SECONDS=60
DEFAULT_REMINDER_MINUTES=60

# 업무 목록 캐시 — 전체 조회 주기(초). 0이면 캐시를 끄고 요청마다 조회한다
TASK_CACHE_SECONDS=86400
# 쓰기 후 다시 조회할 때까지 기다리는 시간(초)
TASK_REFRESH_DELAY_SECONDS=10

# SQLite 파일 위치 (data/는 git에 올라가지 않는다)
DB_PATH=data/desk_pet.db
