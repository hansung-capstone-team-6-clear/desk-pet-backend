# ==========================================
# Desk Pet Backend Environment Configuration
# ==========================================

# Application
APP_NAME=desk-pet-backend
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Eureka Process API
EUREKA_BASE_URL=
EUREKA_USERNAME=
EUREKA_PASSWORD=
EUREKA_TIMEOUT=10

# LLM / MCP
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MCP_ENABLED=true
MCP_SERVER_URL=

# Scheduler (Polling)
SCHEDULER_ENABLED=true
POLL_INTERVAL_SECONDS=60
DEFAULT_REMINDER_MINUTES=60

# WebSocket
WEBSOCKET_ENABLED=true
WEBSOCKET_HEARTBEAT_SECONDS=30

# Logging
LOG_LEVEL=INFO
